model Model
	culture: en-CA
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-CA
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["stg_zomatorestaurantdataset","DimRestaurant","DimLocation","DimCuisines","DimCurrency","FactRestaurant"]

ref table DimRestaurant
ref table DimLocation
ref table DimCuisines
ref table DimCurrency
ref table FactRestaurant

ref cultureInfo en-CA

