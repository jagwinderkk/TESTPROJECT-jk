	partition FactRestaurant = m
		mode: import
		source =
				let
				    Source = stg_zomatorestaurantdataset,
				
				    ValidRows = Table.SelectRows(Source, each (try Number.From([RestaurantID]) otherwise null) <> null),
				
				    Typed = Table.TransformColumnTypes(ValidRows, {
				        {"RestaurantID", Int64.Type},
				        {"AverageCostForTwo", Int64.Type}
				    }),
				
				    LocKeys = Table.Distinct(DimLocation, {"CountryCode", "City", "Locality"}),
				    WithLoc = Table.NestedJoin(Typed, {"CountryCode", "City", "Locality"},
				        LocKeys, {"CountryCode", "City", "Locality"}, "Loc", JoinKind.LeftOuter),
				    ExpLoc = Table.ExpandTableColumn(WithLoc, "Loc", {"LocationKey"}, {"LocationKey"}),
				
				    WithCur = Table.NestedJoin(ExpLoc, {"Currency"}, DimCurrency, {"Currency"}, "Cur", JoinKind.LeftOuter),
				    ExpCur = Table.ExpandTableColumn(WithCur, "Cur", {"CurrencyKey"}, {"CurrencyKey"}),
				
				    WithRest = Table.NestedJoin(ExpCur, {"RestaurantID"}, DimRestaurant, {"RestaurantID"}, "Rest", JoinKind.LeftOuter),
				    ExpRest = Table.ExpandTableColumn(WithRest, "Rest", {"RestaurantKey"}, {"RestaurantKey"}),
				
				    FactRestaurant = Table.SelectColumns(ExpRest, {
				        "RestaurantKey", "RestaurantID", "LocationKey", "CurrencyKey","Cuisines",
				        "AggregateRating", "Votes", "AverageCostForTwo"
				    })
				in
				    FactRestaurant

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

