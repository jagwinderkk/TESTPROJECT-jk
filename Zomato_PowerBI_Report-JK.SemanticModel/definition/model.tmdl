model Model
	culture: en-CA
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-CA
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["bridgeResturantCuisine","DimCuisinesView","Dimcurrency","DIMLocationView","DimRatingView","DimResturantView","FACTResturantView"]

annotation PBI_ProTooling = ["DevMode"]

ref table bridgeResturantCuisine
ref table DimCuisinesView
ref table Dimcurrency
ref table DIMLocationView
ref table DimRatingView
ref table DimResturantView
ref table FACTResturantView

ref cultureInfo en-CA

